# .NET build artifacts
**/bin/
**/obj/
**/publish/
**/test-publish/

# Frontend build output (generated by Vite — never commit)
**/wwwroot/

# Node
**/node_modules/

# IDE — ignore personal settings, preserve shared workspace config
.vs/
.vscode/settings.json
.vscode/settings.json.bak
*.suo
*.user

# OS
Thumbs.db
.DS_Store
desktop.ini

# Logs
*.log
**/logs/

# Test output
**/TestResults/
**/coverage/

# Environment
.env
.env.local
.env.*.local

# Dev launch settings contain local secrets — never commit real credentials
# Copy launchSettings.json and fill in your own credentials locally
**/Properties/launchSettings.json

# Environment-specific appsettings contain real credentials — never commit
**/appsettings.*.json
